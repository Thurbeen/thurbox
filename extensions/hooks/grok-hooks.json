{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state idle || true  # managed by thurbox `extension install` — do not edit",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state working || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state working || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state working || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if cat | sed -n 's/.*\"message\":\"\\([^\"]*\\)\".*/\\1/p' | grep -qiE 'permission|approval|approve'; then thurbox-cli session signal --state blocked ; fi; true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state done || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "thurbox-cli session signal --state idle >/dev/null 2>&1 || true  # managed by thurbox `extension install` — do not edit",
        "powershell": "thurbox-cli session signal --state idle > $null 2>&1; exit 0  # managed by thurbox `extension install`",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "thurbox-cli session signal --state working >/dev/null 2>&1 || true",
        "powershell": "thurbox-cli session signal --state working > $null 2>&1; exit 0",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "thurbox-cli session signal --state working >/dev/null 2>&1 || true",
        "powershell": "thurbox-cli session signal --state working > $null 2>&1; exit 0",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "thurbox-cli session signal --state working >/dev/null 2>&1 || true",
        "powershell": "thurbox-cli session signal --state working > $null 2>&1; exit 0",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt",
        "bash": "thurbox-cli session signal --state blocked >/dev/null 2>&1 || true",
        "powershell": "thurbox-cli session signal --state blocked > $null 2>&1; exit 0",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "thurbox-cli session signal --state done >/dev/null 2>&1 || true",
        "powershell": "thurbox-cli session signal --state done > $null 2>&1; exit 0",
        "timeoutSec": 10
      }
    ]
  }
}

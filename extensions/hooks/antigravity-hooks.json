{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state idle >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state working >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state working >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$(cat | sed -n 's/.*\"message\":\"\\([^\"]*\\)\".*/\\1/p')\" in *permission*|*Permission*|*approval*|*approve*) thurbox-cli session signal --state blocked >/dev/null 2>&1 ;; esac; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state done >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}

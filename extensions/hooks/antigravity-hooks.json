{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state idle || true"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state working || true"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "thurbox-cli session signal --state done || true"
          }
        ]
      }
    ]
  }
}

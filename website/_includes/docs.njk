---
layout: base.njk
root: '..'
extraCss: ['docs.css']
navScrolled: true
activeNav: 'docs'
hasOwnMain: true
---
<div class="docs-page">
  <div class="docs-layout">
    {% include "sidebar.njk" %}

    <button
      class="sidebar-toggle"
      id="sidebar-toggle"
      type="button"
      aria-label="Toggle sidebar"
      aria-controls="docs-sidebar"
      aria-expanded="false"
    >
      &#9776;
    </button>

    <div class="docs-sidebar-backdrop" id="docs-sidebar-backdrop" aria-hidden="true"></div>

    <main class="docs-content" id="main-content">
      <div class="breadcrumbs">
        <a href="{{ root }}/index.html">Home</a>
        <span class="separator">/</span>
        {%- if currentPage == "index" %}
        <span class="current">Docs</span>
        {%- else %}
        <a href="index.html">Docs</a>
        <span class="separator">/</span>
        <span class="current">{{ breadcrumb }}</span>
        {%- endif %}
      </div>

      {{ content | safe }}
    </main>

    <!-- Replaced at build time by the docs-toc transform (eleventy.config.js)
         with an "on this page" rail built from the content's h2/h3 ids, or by
         nothing at all when the page has fewer than two headings. -->
    <!--TOC-->
  </div>
</div>

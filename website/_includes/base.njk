---
root: '.'
extraCss: []
footer: false
navScrolled: false
activeNav: ''
hasOwnMain: false
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Open Graph (Facebook, LinkedIn, Slack, Discord, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}{{ image or site.ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.name }} — TUI Agentic IDE" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ site.url }}{{ image or site.ogImage }}" />

    <!-- Structured data for rich search results -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": {{ site.name | dump | safe }},
        "description": {{ description | dump | safe }},
        "url": {{ (site.url + page.url) | dump | safe }},
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Linux, macOS, Windows",
        "license": "https://opensource.org/licenses/MIT",
        "codeRepository": "https://github.com/Thurbeen/thurbox",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      }
    </script>

    <link rel="icon" href="{{ root }}/assets/favicon.svg" type="image/svg+xml" />
    <!-- Fonts are self-hosted (@font-face lives in core.css) — no Google Fonts
         stylesheet, no preconnects, no third-party request. Preload the two
         faces that paint above the fold so they are in flight alongside the CSS
         rather than after it: the display face for the headline/nav, and the
         mono face for the eyebrow, HUD and install tabs. Inter is body copy
         further down and can wait for the normal CSS-driven fetch. -->
    <link
      rel="preload"
      href="{{ root }}/assets/fonts/press-start-2p-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="{{ root }}/assets/fonts/jetbrains-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Core CSS is concatenated at build time into one file (see the css-bundle
         step in eleventy.config.js), so every page costs one render-blocking
         request for the shared chrome instead of four. Page-specific sheets
         (landing / docs / ui-review) still load separately — they are only
         wanted on the pages that declare them. -->
    <link rel="stylesheet" href="{{ root }}/css/core.css" />
    {%- for css in extraCss %}
    <link rel="stylesheet" href="{{ root }}/css/{{ css }}" />
    {%- endfor %}
  </head>
  <!-- data-assets is how main.js resolves media paths: it is one shared script
       served to pages at different depths, so a hardcoded "assets/…" would 404
       from /docs/. Used by the god-mode easter egg to fetch its clip on demand. -->
  <body data-assets="{{ root }}/assets">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="nav{% if navScrolled %} scrolled{% endif %}" id="nav">
      <!-- prettier-ignore -->
      <a href="{{ root }}/index.html" class="nav-brand"><img src="{{ root }}/assets/logo-mark.svg" alt="" class="nav-brand-mark" width="26" height="26" />thur<span>box</span></a>
      <button
        class="hamburger"
        id="hamburger"
        type="button"
        aria-label="Toggle menu"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="nav-links">
        <li><a href="{{ root }}/index.html#features">Features</a></li>
        <li><a href="{{ root }}/index.html#how-it-works">How It Works</a></li>
        <li><a href="{{ root }}/index.html#walkthrough">Walkthrough</a></li>
        <li><a href="{{ root }}/index.html#installation">Install</a></li>
        <li>
          <a
            href="{{ root }}/docs/index.html"
            {%- if activeNav == "docs" %} style="color: var(--text-primary)"{% endif %}
          >
            Docs
          </a>
        </li>
        <li>
          <a
            href="https://github.com/Thurbeen/thurbox"
            class="github-link"
            target="_blank"
            rel="noopener"
          >
            <svg class="icon-github" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              />
            </svg>
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://discord.gg/fGumcHaxFY"
            class="discord-link"
            target="_blank"
            rel="noopener"
          >
            <svg class="icon-discord" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
              />
            </svg>
            Discord
          </a>
        </li>
      </ul>
    </nav>

    {%- if hasOwnMain %}
    {{ content | safe }}
    {%- else %}
    <main id="main-content">{{ content | safe }}</main>
    {%- endif %}

    {%- if footer %}
    <footer class="footer">
      <div class="container">
        <p>
          Thurbox is open source under the
          <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener">
            MIT License
          </a>
        </p>
        <p>
          <a href="https://github.com/Thurbeen/thurbox" target="_blank" rel="noopener">GitHub</a>
          &middot;
          <a href="https://discord.gg/fGumcHaxFY" target="_blank" rel="noopener">Discord</a>
          &middot; Built with Rust
        </p>
        <!-- The clue. Deliberately names the game, the year and the mode but not
             the code itself, so it reads as flavour text to everyone else. The
             HUD bar's "God Mode" segment is the second, subtler half of the hint
             (it is aria-hidden, so this line is what carries it to a screen
             reader). Payoff lives in main.js. -->
        <p class="footer-secret">
          Ships with a Doom palette &mdash; and the 1993 god-mode cheat still works. Type it
          anywhere.
        </p>
      </div>
    </footer>
    {%- endif %}

    <script src="{{ root }}/js/main.js"></script>
  </body>
</html>

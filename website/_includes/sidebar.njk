{#- Two products, two groups: Fleet (the engine, usable on its own) and thurbox
    (the interface on top of one or more Fleets), then the pages about both.
    Hrefs are relative to /docs/; a page below it (the rendered docs/fleet
    pages) sets docsBase to the way back up. -#}
{%- set sections = [
  { heading: "Fleet", links: [
    { slug: "fleet", href: "fleet.html", label: "What is Fleet" },
    { slug: "fleet-install", href: "fleet-install.html", label: "Install" },
    { slug: "fleet-commands", href: "fleet-commands.html", label: "init, up and apply" },
    { href: "fleet.html#places-and-runtimes", label: "Places and runtimes" },
    { slug: "agents", href: "agents.html", label: "Agents" },
    { slug: "orchestration", href: "orchestration.html", label: "Orchestration" },
    { slug: "fleet-features", href: "fleet-features.html", label: "Features" },
    { slug: "fleet-reference", href: "fleet/index.html", label: "Reference" },
    { slug: "fleet-resources", href: "fleet/index.html#resources", label: "Resources" },
    { slug: "fleet-controllers", href: "fleet/index.html#controllers", label: "Controllers" },
    { slug: "fleet-configuration", href: "fleet/configuration.html", label: "Configuration" }
  ]},
  { heading: "thurbox", links: [
    { slug: "thurbox", href: "thurbox.html", label: "What is thurbox" },
    { slug: "installation", href: "installation.html", label: "Install" },
    { slug: "interface", href: "interface.html", label: "The interface" },
    { slug: "keybindings", href: "keybindings.html", label: "Keybindings" },
    { slug: "configuration", href: "configuration.html", label: "Configuration" },
    { slug: "thurbox-features", href: "thurbox-features.html", label: "Features" }
  ]},
  { heading: "Both", links: [
    { slug: "tutorial", href: "tutorial.html", label: "Tutorial" },
    { slug: "recipes", href: "recipes.html", label: "Recipes" },
    { slug: "comparison", href: "comparison.html", label: "Comparison" },
    { slug: "faq", href: "faq.html", label: "FAQ" },
    { slug: "architecture", href: "architecture.html", label: "Architecture" }
  ]}
] -%}
<aside class="docs-sidebar" id="docs-sidebar">
  {%- for section in sections %}
  <h4>{{ section.heading }}</h4>
  <ul>
    {%- for link in section.links %}
    <li>
      <a
        href="{{ docsBase }}{{ link.href }}"
        {%- if link.slug == currentPage %} class="current-page"{% endif %}
        >{{ link.label }}</a
      >
    </li>
    {%- endfor %}
  </ul>
  {%- endfor %}
</aside>

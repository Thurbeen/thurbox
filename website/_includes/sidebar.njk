<aside class="docs-sidebar" id="docs-sidebar">
  {%- for section in sections %}
  <h4>{{ section.heading }}</h4>
  <ul>
    {%- for link in section.links %}
    {%- if link.subheading %}
    <li class="nav-subheading">{{ link.subheading }}</li>
    {%- else %}
    <li>
      <a
        href="{{ link.href }}"
        {%- if link.slug == currentPage %} class="current-page"{% endif %}
        >{{ link.label }}</a
      >
    </li>
    {%- endif %}
    {%- endfor %}
  </ul>
  {%- endfor %}

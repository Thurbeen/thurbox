{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thurbox gallery overlay",
  "description": "Curated additions to a gallery discovered by a GitHub topic: the mods of thurbox-mods (website/_data/mods.json) or the Fleet plugins of thurbox-fleet-plugins (website/_data/fleet-plugins.json). Each entry names a repository; its other fields replace what the [gallery] table of the repository's mod.toml or fleet-plugin.toml says.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["repo"],
    "properties": {
      "repo": {
        "type": "string",
        "pattern": "^https://github\\.com/[\\w.-]+/(?!.*\\.git$)[\\w.-]+$"
      },
      "hidden": {
        "type": "boolean"
      },
      "install": {
        "type": "string",
        "minLength": 1
      },
      "platforms": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "notes": {
        "type": "string",
        "minLength": 1
      },
      "media": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "alt"],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://",
            "format": "uri"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

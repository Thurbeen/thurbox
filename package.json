{
  "private": true,
  "type": "module",
  "scripts": {
    "build:website": "eleventy",
    "dev:website": "eleventy --serve",
    "lint:html": "htmlhint '_site/**/*.html'",
    "lint:css": "stylelint 'website/css/**/*.css'",
    "lint:js": "eslint 'website/js/**/*.js'",
    "lint:format": "prettier --check 'website/css/**/*.css' 'website/js/**/*.js' 'eleventy.config.js'",
    "lint:website": "npm run build:website && npm run lint:format && npm run lint:html && npm run lint:css && npm run lint:js",
    "fmt:website": "prettier --write 'website/css/**/*.css' 'website/js/**/*.js' 'eleventy.config.js'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eslint": "^10.0.0",
    "htmlhint": "^1.1.4",
    "node-html-parser": "^8.0.2",
    "prettier": "^3.0.0",
    "prismjs": "^1.30.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0"
  }
}

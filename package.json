{
  "private": true,
  "type": "module",
  "scripts": {
    "build:website": "eleventy",
    "dev:website": "eleventy --serve",
    "lint:html": "htmlhint '_site/**/*.html'",
    "lint:css": "stylelint 'website/css/**/*.css'",
    "lint:js": "eslint 'website/js/**/*.js'",
    "lint:format": "prettier --check 'website/css/**/*.css' 'website/js/**/*.js' 'eleventy.config.js'",
    "test:performance-cpu-scale": "node scripts/ci/check-performance-cpu-scale.mjs",
    "lint:website": "npm run check:plugins && npm run test:plugins && npm run build:website && npm run test:performance-cpu-scale && npm run lint:format && npm run lint:html && npm run lint:css && npm run lint:js",
    "fmt:website": "prettier --write 'website/css/**/*.css' 'website/js/**/*.js' 'eleventy.config.js'",
    "test:plugins": "node --test scripts/ci/plugins.test.mjs",
    "check:plugins": "node scripts/ci/validate-plugins.mjs",
    "check:plugins:links": "node scripts/ci/validate-plugins.mjs website/_data/plugins.json --links"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eslint": "^10.0.0",
    "htmlhint": "^1.1.4",
    "node-html-parser": "^9.0.0",
    "prettier": "^3.0.0",
    "prismjs": "^1.30.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
